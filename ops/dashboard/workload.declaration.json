{
  "apiVersion": "dash.shunlyu.com/v1alpha1",
  "kind": "WorkloadDeclaration",
  "metadata": {
    "name": "news",
    "displayName": "News Center"
  },
  "spec": {
    "capabilities": {
      "core.lifecycle": {
        "version": 1,
        "roles": [
          "web",
          "research-worker",
          "jobs-worker"
        ]
      },
      "core.health": {
        "version": 1,
        "checks": [
          {
            "name": "ready",
            "kind": "http",
            "port": "http",
            "path": "/readyz",
            "expectStatus": 200,
            "timeoutSeconds": 5
          }
        ]
      }
    },
    "ports": {
      "http": {
        "containerPort": 8000
      }
    }
  }
}
