FROM ghcr.io/astral-sh/uv:0.13.5@sha256:d3a8362fee5c061dd78452b5915598fc8fbd15050db3a3d919fba5f2e38c629a AS uv
FROM docker.io/library/python:3.12-slim@sha256:6c6ae3622772575c3ac02ecb2b02a06d05f19e1713a0cbff476ef37bca79e90f
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
RUN uv sync --locked --no-dev --extra ai --extra email --no-editable
ENV PATH="/app/.venv/bin:$PATH"
RUN python -c "import scripts.run_collector, scripts.diagnose_partymap_civic, scripts.setup_partymap_civic"
ENTRYPOINT ["python"]
