FROM ghcr.io/astral-sh/uv:0.11.19@sha256:8dffc413a5331398a87faaf8a36576f307310c841ffc7ccd23cc8e84a700edc9 AS uv
FROM docker.io/library/python:3.12-slim@sha256:55842c72c6b3584d06ec84c731fc516b30b8a53ad262ebd085e47ab568b3bfc1
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
RUN uv sync --locked --no-dev --extra ai --extra email --no-editable
ENV PATH="/app/.venv/bin:$PATH"
RUN python -c "import scripts.run_collector, scripts.diagnose_partymap_civic, scripts.setup_partymap_civic"
ENTRYPOINT ["python"]
