[Unit]
Description=Reconcile queued Beehive deep-read jobs every 30 minutes

[Timer]
# beehive-deep-read.path starts the worker as soon as a brief is queued; this timer only recovers
# a missed wakeup, so a 30-minute backstop is enough.
OnCalendar=*:0/30
Persistent=true
Unit=beehive-deep-read.service

[Install]
WantedBy=timers.target
